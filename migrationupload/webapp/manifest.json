{
  "_version": "1.65.0",
  "sap.app": {
    "id": "intech.migrationupload",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.4",
      "toolsId": "5155ff02-df30-4a43-a1d6-dcda34b290f6"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "config": {
      "fullWidth": true
    },
    "dependencies": {
      "minUI5Version": "1.135.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "intech.migrationupload.i18n.i18n",
          "supportedLocales": [
            "en",
            "de",
            "en_US"
          ],
          "fallbackLocale": "de"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": 
      {
				"routerClass": "sap.f.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "intech.migrationupload.view",
				"controlId": "layout",
				"transition": "slide",
				"bypassed": {
				},
				"async": true
			},
      "routes": [
        {
          "name": "Master",
          "pattern": "",
          "target": [
            "Master"
          ]
        },
        {
          "name": "Detail",
          "pattern": "Detail/{sParam}",
          "target": [
            "Detail"
          ]
        }
      ],
      "targets": {
        "Master": {
          "id": "master",
          "name": "Master",
          "viewLevel": 0,
          "controlAggregation": "beginColumnPages"
        },
        "Detail": {
          "id": "detail",
          "name": "Detail",
          "viewLevel": 1,
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "intech.migrationupload.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}